# PostgreSQL
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=school;Username=school_user;Password=change_this_secure_password;SslMode=Require;Trust Server Certificate=true

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars
JWT_ISSUER=SchoolApi
JWT_AUDIENCE=SchoolApp
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage — Cloudflare R2 / S3 (leave empty to use local uploads/ in dev)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=